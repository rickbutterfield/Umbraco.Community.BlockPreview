{
  "$schema": "https://raw.githubusercontent.com/dotnet/Nerdbank.GitVersioning/main/src/NerdBank.GitVersioning/version.schema.json",
  "version": "5.0.0-rc3",
  "assemblyVersion": {
    "precision": "build"
  },
  "gitCommitIdShortFixedLength": 7,
  "nuGetPackageVersion": {
    "semVer": 2.0
  },
  "publicReleaseRefSpec": [
    "^refs/heads/release/",
    "^refs/heads/main$",
    "^refs/tags/v"
  ],
  "cloudBuild": {
    "buildNumber": {
      "enabled": true
    }
  },
  "release": {
    "tagName": "v{version}",
    "branchName": "release/{version}"
  }
}
