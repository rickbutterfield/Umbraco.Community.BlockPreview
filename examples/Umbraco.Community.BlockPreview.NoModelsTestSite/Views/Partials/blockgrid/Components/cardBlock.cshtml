@inherits UmbracoViewPage<BlockGridItem>

<div class="card @(Model.ColumnSpan == 6 ? "--medium" : null)">

    <div class="card-media">
        @{
            var image = Model.Content.Value<MediaWithCrops>("image");
            if (image is not null)
            {
                <img src="@image.GetCropUrl(width:Model.ColumnSpan == 6 ? 720 : 360)"/>
            }
            else
            {
                <p>Missing image</p>
            }
        }
    </div>
    <div class="card-content">
        <h4>@(Model.Content.Value<string>("headline"))</h4>
        <div>@(Model.Content.Value<IHtmlEncodedString>("richText"))</div>
    </div>

</div>
